{
  "manifest_version": 3,
  "name": "인하 자비스",
  "version": "0.7.0",
  "description": "천원의 아침밥, 인하공지, 정석 좌석을 한곳에서 확인하는 인하대 생활 도우미",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*.inha.ac.kr/*"],
  "icons": {
    "16": "icons/inha-16.png",
    "32": "icons/inha-32.png",
    "48": "icons/inha-48.png",
    "128": "icons/inha-128.png"
  },
  "action": {
    "default_title": "인하 자비스 열기",
    "default_icon": {
      "16": "icons/inha-16.png",
      "32": "icons/inha-32.png",
      "48": "icons/inha-48.png",
      "128": "icons/inha-128.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" }
}
